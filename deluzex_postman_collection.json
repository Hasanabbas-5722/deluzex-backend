{
  "info": {
    "name": "Deluzex Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Hasan\",\n  \"last_name\": \"Chaudhary\",\n  \"email\": \"hasan@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"+919876543210\",\n  \"accept_terms\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", jsonData.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hasan@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Modern Wall Light",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "120.00",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Chandeliers",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Beautiful chandeliers",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Newsletter",
      "item": [
        {
          "name": "Subscribe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/newsletter/subscribe",
              "host": ["{{base_url}}"],
              "path": ["newsletter", "subscribe"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get My Orders",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/my-orders",
              "host": ["{{base_url}}"],
              "path": ["orders", "my-orders"]
            }
          }
        },
        {
          "name": "Get Orders by Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders?email=hasan@example.com",
              "host": ["{{base_url}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "email",
                  "value": "hasan@example.com"
                }
              ]
            }
          }
        },
        {
          "name": "Get Order By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/:order_id",
              "host": ["{{base_url}}"],
              "path": ["orders", ":order_id"],
              "variable": [
                {
                  "key": "order_id",
                  "value": "66bc0f823a967a5c12345678"
                }
              ]
            }
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hasan@example.com\",\n  \"phone\": \"+919876543210\",\n  \"shipping_address\": {\n    \"first_name\": \"Hasan\",\n    \"last_name\": \"Chaudhary\",\n    \"street\": \"123 Modern Street\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"pin_code\": \"400001\"\n  },\n  \"items\": [\n    {\n      \"product_id\": \"66bc0f823a967a5c12345678\",\n      \"title\": \"Pendant Lights\",\n      \"price\": 1499.0,\n      \"quantity\": 2,\n      \"image\": \"https://ik.imagekit.io/2s78gfu2x/categories/pendentlight.jpeg\"\n    }\n  ],\n  \"subtotal\": 2998.0,\n  \"gst\": 539.64,\n  \"delivery\": 0.0,\n  \"total\": 3537.64,\n  \"payment_method\": \"cod\",\n  \"notes\": \"Deliver on weekend\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipped\",\n  \"tracking_number\": \"TRK-12345678\",\n  \"notes\": \"Shipped via BlueDart\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/:order_id/status",
              "host": ["{{base_url}}"],
              "path": ["orders", ":order_id", "status"],
              "variable": [
                {
                  "key": "order_id",
                  "value": "66bc0f823a967a5c12345678"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/:order_id/cancel",
              "host": ["{{base_url}}"],
              "path": ["orders", ":order_id", "cancel"],
              "variable": [
                {
                  "key": "order_id",
                  "value": "66bc0f823a967a5c12345678"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
